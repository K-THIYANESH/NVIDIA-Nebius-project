# ==============================================================================
# GUARDIAN SWARM CONFIGURATION TEMPLATE
# Controlled Agent Execution • Evidence • Verification
# Nebius x NVIDIA Global AI Hackathon (Best Apps & Agents Track)
# ==============================================================================

# --- Nebius Token Factory & NVIDIA Nemotron Configuration ---
# Your Nebius Token Factory Bearer API Key (obtain from Nebius Console)
NEBIUS_API_KEY=your_nebius_api_key_here

# Nebius AI Studio OpenAI-compatible API base endpoint
# Primary: https://api.studio.nebius.ai/v1
# Alternative: https://api.tokenfactory.nebius.com/v1
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# NVIDIA model deployed on Nebius AI Studio
# Recommended options:
# - nvidia/Llama-3_1-Nemotron-Ultra-253B-v1  (Recommended: Best reasoning & governance)
# - nvidia/nemotron-3-super-120b-a12b         (Fast multi-agent reasoning, planning)
# - nvidia/Nemotron-3_5-Lightning             (High-throughput, low-latency verification)
NEBIUS_MODEL=nvidia/Llama-3_1-Nemotron-Ultra-253B-v1

# --- Local & Fallback Engine Settings ---
# Local model cache directory
GUARDIAN_CACHE_DIR=./models

# Device usage for local models
GUARDIAN_USE_CUDA=False

# Force Heuristics Rules Engine (Offline development & instant test validation)
GUARDIAN_FORCE_HEURISTICS=True

# --- Optional Provider Keys (If routing tasks to auxiliary providers) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=
GROK_API_KEY=
DEEPSEEK_API_KEY=
