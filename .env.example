# --- Nebius Token Factory & NVIDIA Nemotron Configuration ---
# Your Nebius Token Factory Bearer API Key (obtain from Nebius Console)
NEBIUS_API_KEY=your_nebius_api_key_here

# Nebius Token Factory OpenAI-compatible API base endpoint (confirmed working)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

#   nvidia/nemotron-3.5-bolt-e4b             ← Fast tool-use, agentic gate verification (NVIDIA NIM / Token Factory)
#   nvidia/nemotron-3-super-120b-a12b        ← Recommended: reasoning + agents ($0.30/$0.90 per 1M)
#   nvidia/Nemotron-3_5-Lightning            ← Cheapest: fast, high-throughput ($0.06/$0.24 per 1M)
#   nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B   ← Cheapest: compact, 262K context ($0.06/$0.24 per 1M)
#   nvidia/Nemotron-3.5-Super-VL             ← Multimodal vision+text ($0.30/$0.90 per 1M)
#   nvidia/Nemotron-3-Ultra-550b-a55b        ← Most powerful 550B ($1.00/$3.00 per 1M)
NEBIUS_MODEL=nvidia/nemotron-3.5-bolt-e4b

# --- Local & Fallback Engine Settings ---
# Local model cache directory
GUARDIAN_CACHE_DIR=./models

# Device usage for local models
GUARDIAN_USE_CUDA=False

# Force Heuristics Rules Engine (Offline development & instant test validation)
GUARDIAN_FORCE_HEURISTICS=True

# --- Optional Provider Keys (If routing tasks to auxiliary providers) ---
# NVIDIA NIM (build.nvidia.com) — key starts with nvapi-
# Model: nvidia/nemotron-3.5-bolt-e4b (fast, tool-use, agentic tasks)
# Endpoint: https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=
GROK_API_KEY=
DEEPSEEK_API_KEY=
